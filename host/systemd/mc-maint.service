[Unit]
Description=asus-node maintenance reboot (only if reboot-required and nobody is playing)
Documentation=file:///home/mm-mike/minecraft-ai-host/AGENTS.md
# Wait out an unattended-upgrade that is still running at 05:40.
After=apt-daily-upgrade.service docker.service
OnFailure=mc-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/mc-maint
TimeoutStartSec=10min
