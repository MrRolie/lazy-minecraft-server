[Unit]
Description=Egress fence for the Discord bridge network br-mcve (raw-table drops to host, LAN and tailnet)
Documentation=file:///home/mm-mike/minecraft-ai-host/bridge/README.md
# BEFORE dockerd: the drops exist before any container with a restart policy comes back at boot. It runs the
# root-owned copy setup.sh installs in /usr/local/sbin, never a checkout path.
After=network-pre.target
Before=docker.service
OnFailure=mc-alert@%n.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/mc-bridge-fence apply
ExecReload=/usr/local/sbin/mc-bridge-fence apply
# NO ExecStop, deliberately: `systemctl restart` runs the stop leg first, and a remove there would open the
# bridge while docker keeps it running (and leave it open if the apply failed). Stopping this unit leaves the
# rules IN PLACE (fail-closed). Removal is attended: stop the bridge, then `mc-bridge-fence remove`.

[Install]
WantedBy=multi-user.target
