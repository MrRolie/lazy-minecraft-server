[Unit]
Description=Minecraft friend server (docker compose): start at boot, stop gracefully BEFORE docker at shutdown
Documentation=file:///home/mm-mike/minecraft-ai-host/AGENTS.md
# Wants=, not Requires=: Requires= would also restart this unit (stop + start Minecraft) whenever
# docker.service restarts (e.g. a manual `systemctl restart docker`), which is what live-restore avoids.
# After= alone orders the shutdown: this unit stops first, while docker is still up.
Wants=docker.service network-online.target
After=docker.service network-online.target
OnFailure=mc-alert@%n.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=mm-mike
WorkingDirectory=/home/mm-mike/minecraft-ai-host
# Minecraft alone first, then the Discord bridge, which may fail without stopping anything ("-"). A plain
# `up -d` aborts EVERY service when the bridge image is missing and can't be built (e.g. no network at
# boot); nothing about the bridge may stop Minecraft from starting. --no-build: never build at boot.
# mc-bridge-up starts the bridge only behind its egress fence, with --no-build and a 60 s timeout (so a hung
# start can't eat TimeoutStartSec), and mc-alerts when it doesn't start. Minecraft is untouched either way.
ExecStart=/usr/bin/docker compose up -d minecraft
ExecStartPost=-/usr/local/sbin/mc-bridge-up
ExecStop=/usr/bin/docker compose stop -t 120
TimeoutStartSec=5min
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
