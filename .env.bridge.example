# The Discord bridge's own least-capability bot (bridge/README.md), NOT the admin bot's token (discord/.env).
# On the game host: cp .env.bridge.example .env.bridge && chmod 600 .env.bridge, then fill in the token.
# Read by Compose with env_file format: raw ('$' is literal); only the bridge container sees it.
DISCORD_BRIDGE_TOKEN=...
# Written by kit/render.py from kit.toml discord.guild_id (its one home); render rewrites only this line.
DISCORD_GUILD_ID=...
