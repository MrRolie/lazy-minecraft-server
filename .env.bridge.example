# The Discord bridge's own least-capability bot (bridge/README.md), NOT the Claudius admin token.
# On asus-node: cp .env.bridge.example .env.bridge && chmod 600 .env.bridge, then fill in the token.
# Read by Compose with env_file format: raw ('$' is literal); only the bridge container sees it.
DISCORD_BRIDGE_TOKEN=...
DISCORD_GUILD_ID=123456789012345678
