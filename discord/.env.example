# discord/sync.py only — workstation-side. Kept apart from the Compose .env so the token never reaches the game container.
DISCORD_TOKEN=...
DISCORD_GUILD_ID=123456789012345678
# The asus-node Tailscale share link, filled into #setup by {secret:share_link} and never printed by sync.
# Admin console → Machines → asus-node → Share → reusable link. The values below are placeholders that
# sync refuses on purpose; never commit the real link (it is an access credential).
TAILSCALE_SHARE_LINK=https://login.tailscale.com/admin/invite/<code>
# Optional: the day the link was made. Sync warns from day 25 (unused links may expire at 30 days).
TAILSCALE_SHARE_LINK_DATE=YYYY-MM-DD
