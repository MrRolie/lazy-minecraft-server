# discord/sync.py only (the machine that runs the sync). Kept apart from the Compose .env so the token never reaches the game container.
DISCORD_TOKEN=...
# The guild id is not here: it lives in kit.toml (discord.guild_id). A DISCORD_GUILD_ID line left here must equal it.
# The game host's Tailscale share link, filled into #setup by {secret:share_link} and never printed by sync.
# Admin console → Machines → <the game host> → Share → reusable link. The values below are placeholders that
# sync refuses on purpose; never commit the real link (it is an access credential).
TAILSCALE_SHARE_LINK=https://login.tailscale.com/admin/invite/<code>
# Optional: the day the link was made. Sync warns from day 25 (unused links may expire at 30 days).
TAILSCALE_SHARE_LINK_DATE=YYYY-MM-DD
