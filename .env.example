# Minecraft server (read by Compose via env_file format: raw — '$' is literal)
RCON_PASSWORD=change-me
# World directory under mc_data/. `world` is the friends' world; anything else is a declared-disposable spike.
LEVEL=world
# kit/render.py adds the compose keys from kit.toml below this line (MEMORY, TZ, DIFFICULTY, MAX_PLAYERS,
# VIEW_DISTANCE, SIMULATION_DISTANCE; SEED and OPS when set) and rewrites only those lines.
